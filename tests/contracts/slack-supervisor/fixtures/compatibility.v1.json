    "duplicate_behavior": "unknown",
    "reply_latency_bucket": "unknown",
    "reacts_to_edits": "unknown",
    "unrelated_message_inert": "unknown",
    "decision": "NO_GO",
    "blocking_reason_class": "unmeasured"
  },
  "strategy_cases": [
    {
      "name": "same_thread_with_marker",
      "reply_placement": "same_thread",
      "marker_preserved": "yes",
      "expect_strategy": "thread_binding_with_marker"
    },
    {
      "name": "same_thread_without_marker",
      "note": "The binding is sufficient because a thread holds at most one non-terminal workflow.",
