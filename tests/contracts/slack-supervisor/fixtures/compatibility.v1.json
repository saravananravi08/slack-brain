      "marker_preserved": "no",
      "expect_strategy": "thread_binding_only"
    },
    {
      "name": "same_thread_marker_unmeasured",
      "reply_placement": "same_thread",
      "marker_preserved": "unknown",
      "expect_strategy": "thread_binding_only"
    },
    {
      "name": "channel_root_with_marker_requires_the_marker",
      "note": "This is the row that would force an amendment to events.md §4.2 check 3.",
      "reply_placement": "channel_root",
      "marker_preserved": "yes",
      "expect_strategy": "marker_required"
    },
    {
      "name": "new_thread_with_marker_requires_the_marker",
      "reply_placement": "new_thread",
      "marker_preserved": "yes",
      "expect_strategy": "marker_required"
    },
    {
      "name": "channel_root_without_marker_is_uncorrelatable",
