  "phase_recommendation_cases": [
    { "name": "both_go", "decisions": ["GO", "GO"], "expect": "GO" },
    { "name": "kilo_only", "decisions": ["GO", "NO_GO"], "expect": "PARTIAL" },
    { "name": "linear_only", "decisions": ["NO_GO", "GO"], "expect": "PARTIAL" },
    { "name": "neither", "decisions": ["NO_GO", "NO_GO"], "expect": "NO_GO" }
  ],
  "blocked_path": {
    "note": "D029 — a NO_GO blocks only the failing target, and there is no fallback of any kind.",
    "blocked_target": "linear",
    "passing_target": "kilo",
    "expect_dispatch_to_blocked_target": {
      "allowed": false,
      "failure_class": "compatibility_blocked",
      "workflow_state": "waiting_human"
    },
    "expect_dispatch_to_passing_target": { "allowed": true },
    "forbidden_fallbacks": [
      "direct_linear_connector",
      "direct_github_connector",
      "direct_kilo_cloud_connector",
      "mcp_connector",
      "alternative_transport",
      "identity_substitution",
      "inferred_success"
    ],
    "expect_partial_unblocks_p09_alone": false
  },
  "conditional_clauses": [
    { "clause": "events.md §4.2", "depends_on": "reply_placement" },
    { "clause": "actions.md §5.1", "depends_on": "marker_preserved" },
    { "clause": "actions.md §5.2", "depends_on": "requires_mention" },
    { "clause": "workflow-state.md §3.1", "depends_on": "completion_signal" },
    { "clause": "workflow-state.md §5", "depends_on": "fresh_session_support" },
    { "clause": "dispatch.md §5", "depends_on": "marker_preserved" },
    { "clause": "events.md §6", "depends_on": "duplicate_behavior" }
