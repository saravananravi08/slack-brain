{
  "contract_set": "slack-supervisor",
  "contract_version": "1.0.0",
  "synthetic": true,
  "defines": "docs/architecture/slack-supervisor/compatibility.md",
  "note": "These are SHAPES, not measurements. T802 fills them from a live probe in its own branch and must not widen an enum to fit an observation.",
  "required_fields": [
    "contract_version",
    "logical_target",
    "bot_alias",
    "observed_on",
    "sample_count",
    "accepts_bot_authored",
    "requires_mention",
    "reply_placement",
    "reply_identity_stable",
    "marker_preserved",
    "distinguishes_outcomes",
    "completion_signal",
    "duplicate_behavior",
    "reply_latency_bucket",
    "reacts_to_edits",
    "unrelated_message_inert",
    "decision",
    "blocking_reason_class"
  ],
  "forbidden_fields": [
    "message_text",
    "reply_text",
    "instruction_text",
    "raw_payload",
    "prompt",
    "model_output",
    "channel_id",
    "workspace_id",
    "bot_id",
    "app_id",
    "user_id",
    "token",
    "screenshot",
    "trace"
  ],
  "enums": {
    "tri": ["yes", "no", "unknown"],
    "reply_placement": ["same_thread", "channel_root", "new_thread", "none", "unknown"],
    "completion_signal": ["explicit", "implicit", "none", "unknown"],
    "duplicate_behavior": ["ignored", "second_action", "error", "unknown"],
    "latency_bucket": ["lt_5s", "lt_30s", "lt_5m", "gte_5m", "none", "unknown"],
    "blocking_reason": [
      "ignores_bot_authored",
      "uncorrelatable_replies",
      "unstable_identity",
      "duplicate_side_effects",
      "no_outcome_signal",
      "unmeasured"
    ],
    "decision": ["GO", "NO_GO"],
    "phase_recommendation": ["GO", "PARTIAL", "NO_GO"]
  },
  "unmeasured_template": {
    "note": "The shape T802 starts from. Every Tri and enum begins at `unknown`, which is a NO_GO under rule 6 until measured.",
    "contract_version": "1.0.0",
    "logical_target": "kilo",
    "bot_alias": "trusted-bot-a",
    "observed_on": "2026-09-01",
    "sample_count": 1,
    "accepts_bot_authored": "unknown",
    "requires_mention": "unknown",
    "reply_placement": "unknown",
    "reply_identity_stable": "unknown",
    "marker_preserved": "unknown",
    "distinguishes_outcomes": "unknown",
