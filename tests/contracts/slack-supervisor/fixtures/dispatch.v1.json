      "expect_workflow_state": "dispatched",
      "expect_reason_class": null
    },
    {
      "name": "in_flight_with_a_readable_empty_thread_was_not_delivered",
      "delivery_state": "in_flight",
      "own_outgoing_record": false,
      "marker_found_in_thread": false,
      "thread_readable": true,
      "expect_delivery_state": "failed",
      "expect_workflow_state": "ready",
      "expect_reason_class": null,
      "note": "Proven non-delivery: the thread was readable and the instruction is not in it. This is the only route from an ambiguous attempt to a retry, and it is a route through proof."
    },
    {
      "name": "in_flight_with_an_unreadable_thread_asks_a_human",
      "note": "Re-sending would risk a duplicate instruction, which for a coding bot is duplicated work. Asking is cheap.",
