  "retry_convergence": {
    "note": "GS-FR-043 \u2014 retries share one action_id and one version; the first success wins under compare-and-set and later attempts stop.",
    "action_id": "act_supv_0001",
    "version": 1,
    "attempts": [
      {
        "attempt": 1,
        "result": "failed",
        "expect_delivery_state": "failed",
