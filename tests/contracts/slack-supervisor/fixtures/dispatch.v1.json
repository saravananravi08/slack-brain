        "workflow_id": "wf_supv_0001",
        "source_event_key": "T0SUPVTEST/C0SUPVTESTA/1756684860.000200",
        "already_claimed": false,
        "expect_allowed": true,
        "expect_action_claim_key": "ev:T0SUPVTEST/C0SUPVTESTA/1756684860.000200",
