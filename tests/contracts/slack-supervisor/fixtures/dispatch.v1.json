  "illegal_delivery_transitions": [
    {
      "name": "delivered_is_terminal",
      "from": "delivered",
      "to": "pending",
      "note": "A delivered action is never re-sent."
    },
    {
      "name": "delivered_cannot_fail_afterwards",
      "from": "delivered",
      "to": "failed"
    },
    {
      "name": "abandoned_is_terminal",
      "from": "abandoned",
      "to": "in_flight"
    },
    {
      "name": "failed_cannot_become_delivered",
      "from": "failed",
      "to": "delivered"
    },
    {
      "name": "pending_cannot_jump_to_delivered",
      "from": "pending",
      "to": "delivered",
      "note": "Delivery is only confirmed from an in-flight attempt that returned an outgoing message identity."
    },
    {
      "name": "abandoned_cannot_return_to_failed",
      "from": "abandoned",
      "to": "failed"
    }
  ],
  "retry_convergence": {
    "note": "GS-FR-043 — attempts are serial. Attempt N+1 is created only after attempt N durably records a definitive pre-acceptance rejection.",
    "action_id": "act_supv_0001",
    "version": 1,
    "attempts": [
      {
        "attempt": 1,
        "prior_attempt": null,
        "prior_outcome": null,
        "result": "definitive_failure",
        "expect_delivery_state": "failed",
        "failure_class": "slack_rate_limited"
      },
      {
        "attempt": 2,
        "prior_attempt": 1,
        "prior_outcome": "definitive_failure",
        "result": "delivered",
        "expect_delivery_state": "delivered"
      }
    ],
    "expect_distinct_actions": 1,
    "expect_expected_bot_turns": 1,
    "first_attempt_failure_class": "slack_rate_limited",
    "expect_attempts_serial": true,
    "expect_overlapping_attempts": false
  },
  "failed_dispatch": [
    {
      "name": "definitive_failure_leaves_the_workflow_ready",
      "note": "dispatch.md §4 — only a definitive non-delivery reaches this path at all; an ambiguous attempt goes to reconciliation first (§3.2).",
      "failure_class": "slack_permission_denied",
      "workflow_state_before": "ready",
      "consecutive_failures_before": 0,
      "max_consecutive_failures": 3,
      "expect_workflow_state": "ready",
      "expect_consecutive_failures": 1,
      "expect_expected_actor": "gist"
    },
    {
      "name": "rate_limit_leaves_the_workflow_ready",
      "failure_class": "slack_rate_limited",
      "workflow_state_before": "ready",
      "consecutive_failures_before": 1,
      "max_consecutive_failures": 3,
      "expect_workflow_state": "ready",
      "expect_consecutive_failures": 2,
      "expect_expected_actor": "gist"
    },
    {
      "name": "invalid_request_is_a_definitive_failure",
      "failure_class": "slack_invalid_request",
      "workflow_state_before": "ready",
      "consecutive_failures_before": 0,
      "max_consecutive_failures": 3,
      "expect_workflow_state": "ready",
      "expect_consecutive_failures": 1,
      "expect_expected_actor": "gist",
      "note": "Reconciliation can never produce this state; only Slack rejecting the post before accepting it can."
    },
    {
      "name": "reaching_the_failure_limit_asks_a_human",
      "failure_class": "slack_rate_limited",
      "workflow_state_before": "ready",
      "consecutive_failures_before": 2,
      "max_consecutive_failures": 3,
      "expect_workflow_state": "waiting_human",
      "expect_consecutive_failures": 3,
      "expect_expected_actor": "human"
    }
  ],
  "reconciliation": [
    {
      "name": "in_flight_with_our_own_outgoing_record_was_delivered",
      "note": "The send path persists outgoing messages directly, so the local record is authoritative and does not depend on Slack echo behavior.",
      "delivery_state": "in_flight",
      "own_outgoing_record": true,
      "marker_found_in_thread": false,
      "thread_readable": false,
      "expect_delivery_state": "delivered",
      "expect_workflow_state": "dispatched",
      "expect_reason_class": null
    },
    {
      "name": "in_flight_with_marker_in_thread_was_delivered",
      "delivery_state": "in_flight",
      "own_outgoing_record": false,
      "marker_found_in_thread": true,
      "thread_readable": true,
      "expect_delivery_state": "delivered",
      "expect_workflow_state": "dispatched",
      "expect_reason_class": null
    },
    {
      "name": "in_flight_with_a_readable_empty_thread_is_still_inconclusive",
      "note": "The defect this fixes. A post can be accepted and not visible yet: event delivery lags, history lags, our own capture may be mid-write, and a rate-limited read returns a short page. Absence looks identical to non-delivery at the moment we look.",
      "delivery_state": "in_flight",
      "own_outgoing_record": false,
      "marker_found_in_thread": false,
      "thread_readable": true,
      "expect_delivery_state": "in_flight",
      "expect_workflow_state": "waiting_human",
      "expect_reason_class": "dispatch_unreconciled"
    },
    {
      "name": "in_flight_with_an_unreadable_thread_asks_a_human",
      "delivery_state": "in_flight",
      "own_outgoing_record": false,
      "marker_found_in_thread": false,
      "thread_readable": false,
      "expect_delivery_state": "in_flight",
      "expect_workflow_state": "waiting_human",
      "expect_reason_class": "dispatch_unreconciled"
    },
    {
      "name": "inline_reconciliation_after_a_timeout_uses_the_same_rules",
      "note": "dispatch.md §5 — one mechanism, two callers. A timeout mid-run and a crash mid-send leave the same question behind.",
      "delivery_state": "in_flight",
      "own_outgoing_record": false,
      "marker_found_in_thread": true,
      "thread_readable": true,
      "expect_delivery_state": "delivered",
      "expect_workflow_state": "dispatched",
      "expect_reason_class": null
    }
  ],
  "restart": {
    "note": "GS-FR-015 — recovery replays state, not effects.",
    "expect_resends_confirmed_delivered": false,
    "expect_reapplies_committed_transitions": false,
    "expect_rearms_timers_from_durable_timestamps": true,
    "expect_reconciles_before_accepting_new_events": true,
    "expect_drains_pending_outbox_before_new_events": true,
    "expect_pending_first_send_resumed": true
  },
  "ordering": {
    "note": "dispatch.md §6 — the checkpoint write precedes the Slack call. A process that sends first and records after cannot survive its own crash.",
    "expect_order": [
      "commit_action_claim_and_pending_outbox",
      "move_pending_to_in_flight",
      "slack_call",
      "record_result"
    ],
    "storage_unavailable_expect_sent": false
  },
