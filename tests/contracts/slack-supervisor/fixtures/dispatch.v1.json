      },
      {
        "attempt": 2,
        "result": "delivered",
        "expect_delivery_state": "delivered"
      },
      {
        "attempt": 3,
        "result": "delivered",
        "note": "A slow original completing after the retry already succeeded.",
        "expect_delivery_state": "delivered",
        "expect_additional_dispatch": false
      }
