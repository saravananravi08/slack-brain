        "consecutive_failures": 0,
        "max_consecutive_failures": 3,
        "workflow_state": "ready",
        "expect_allowed": false
      },
      {
        "name": "pending_may_not_retry",
        "delivery_state": "pending",
        "consecutive_failures": 0,
        "max_consecutive_failures": 3,
        "workflow_state": "ready",
        "expect_allowed": false
      },
      {
        "name": "delivered_may_never_retry",
        "delivery_state": "delivered",
        "consecutive_failures": 0,
        "max_consecutive_failures": 3,
        "workflow_state": "ready",
        "expect_allowed": false
      },
      {
