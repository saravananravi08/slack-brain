      },
      {
        "name": "retried_delivery_of_that_notice_is_refused",
        "note": "The defect this fixes: without an event-global key, a Slack retry could produce a second notification.",
        "action_class": "reply_user",
        "workflow_id": null,
        "source_event_key": "T0SUPVTEST/C0SUPVTESTA/1756684920.000300",
        "already_claimed": true,
        "expect_allowed": false,
        "expect_failure_class": "claim_conflict"
      },
      {
        "name": "ordinary_assistance_outside_a_workflow_is_claimed",
        "action_class": "reply_user",
        "workflow_id": null,
