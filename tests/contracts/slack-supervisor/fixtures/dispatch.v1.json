        "already_claimed": false,
        "expect_allowed": true,
        "expect_action_claim_key": "ev:T0SUPVTEST/C0SUPVTESTA/1756684860.000200"
      }
    ],
    "expect_workflow_in_key": false,
    "expect_workflow_recorded_as_metadata": true
  },
  "delivery_outcomes": {
    "note": "dispatch.md \u00a73.1 \u2014 three answers, not two. `definitive_failure` means Slack refused the call before accepting it; everything ambiguous is `indeterminate`.",
    "definitive_non_delivery": [
      "slack_permission_denied",
      "slack_rate_limited",
      "slack_invalid_request",
      "destination_unresolved"
    ],
    "cases": [
      {
        "name": "identity_returned_is_delivered",
        "attempt": {
          "slack_message_key": "T0SUPVTEST/C0SUPVTESTA/1756684865.000250",
          "error_class": null,
          "timed_out": false
        },
        "expect_outcome": "delivered",
        "current_delivery_state": "in_flight",
        "expect_delivery_state": "delivered"
      },
      {
        "name": "permission_denied_is_definitive",
        "attempt": {
          "slack_message_key": null,
          "error_class": "slack_permission_denied",
          "timed_out": false
        },
        "expect_outcome": "definitive_failure",
        "current_delivery_state": "in_flight",
        "expect_delivery_state": "failed"
      },
      {
        "name": "rate_limited_is_definitive",
        "attempt": {
          "slack_message_key": null,
          "error_class": "slack_rate_limited",
          "timed_out": false
        },
        "expect_outcome": "definitive_failure",
        "current_delivery_state": "in_flight",
        "expect_delivery_state": "failed"
      },
      {
        "name": "invalid_request_is_definitive",
        "attempt": {
          "slack_message_key": null,
          "error_class": "slack_invalid_request",
          "timed_out": false
        },
        "expect_outcome": "definitive_failure",
        "current_delivery_state": "in_flight",
        "expect_delivery_state": "failed"
      },
      {
        "name": "timeout_is_indeterminate",
        "note": "The defect this fixes. A slow post that eventually succeeded would previously have been retried while still in flight.",
        "attempt": {
          "slack_message_key": null,
          "error_class": null,
          "timed_out": true
        },
        "expect_outcome": "indeterminate",
        "current_delivery_state": "in_flight",
        "expect_delivery_state": "in_flight"
      },
      {
        "name": "transport_error_is_indeterminate",
        "attempt": {
          "slack_message_key": null,
          "error_class": "slack_transport_error",
          "timed_out": false
        },
        "expect_outcome": "indeterminate",
        "current_delivery_state": "in_flight",
        "expect_delivery_state": "in_flight"
      },
      {
        "name": "silence_is_indeterminate",
        "note": "No identity, no error, no timeout. An absence of error is not a confirmation, and it is not a disproof either.",
        "attempt": {
          "slack_message_key": null,
          "error_class": null,
          "timed_out": false
        },
        "expect_outcome": "indeterminate",
        "current_delivery_state": "in_flight",
        "expect_delivery_state": "in_flight"
      },
      {
        "name": "timeout_wins_over_a_definitive_error_class",
        "attempt": {
          "slack_message_key": null,
          "error_class": "slack_permission_denied",
          "timed_out": true
        },
        "expect_outcome": "indeterminate",
        "current_delivery_state": "in_flight",
        "expect_delivery_state": "in_flight"
      }
    ]
  },
