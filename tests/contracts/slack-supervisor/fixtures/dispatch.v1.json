  "unbound_visible_actions": {
    "note": "dispatch.md §2 — two externally visible actions carry no workflow_id. A workflow-scoped claim would have left them outside GS-FR-024 entirely.",
    "cases": [
      {
        "name": "unmatched_trusted_bot_notice_is_claimed",
        "action_class": "reply_user",
        "workflow_id": null,
        "source_event_key": "T0SUPVTEST/C0SUPVTESTA/1756684920.000300",
        "already_claimed": false,
        "expect_allowed": true,
        "expect_action_claim_key": "ev:T0SUPVTEST/C0SUPVTESTA/1756684920.000300",
