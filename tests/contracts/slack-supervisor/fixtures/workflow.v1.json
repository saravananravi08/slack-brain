      "request": {
        "expected_state": "ready",
        "expected_action_version": 1,
        "next_state": "dispatched",
        "source_event_key": "T0SUPVTEST/C0SUPVTESTA/1756684860.000200"
      },
      "expect_outcome": "idempotent",
      "expect_reason": "duplicate_source_event"
    },
    {
      "name": "null_version_expectation_matches_null_stored",
