# Required Slack Socket Mode credentials. Replace through an approved secret store.
SLACK_BOT_TOKEN=<required-bot-credential>
SLACK_APP_TOKEN=<required-app-level-credential>

# Deny-by-default workspace and channel policy. Never commit real IDs.
GIST_APPROVED_WORKSPACE_ID=<required-workspace-id>
GIST_APPROVED_CHANNEL_IDS=<required-comma-separated-channel-ids>
GIST_USER_ALLOWLIST=
GIST_DM_SHARED_KNOWLEDGE=false

# Approved generation provider and pinned model.
ANTHROPIC_API_KEY=<required-anthropic-credential>
GIST_MODEL=claude-opus-5

# Approved embedding provider and pinned model.
OPENAI_API_KEY=<required-openai-credential>
EMBEDDING_MODEL=openai/text-embedding-3-small

# Absolute file URL outside the repository.
MASTRA_DATABASE_URL=file:/absolute/path/outside/repository/mastra.db
