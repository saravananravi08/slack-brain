{
  "contract_version": "1.0.0",
  "synthetic": true,
  "defines": "slack-event.md",
  "classification": [
    {
      "name": "dm_addressed",
      "expect_class": "addressed",
      "event": {
        "contract_version": "1.0.0", "class": "addressed",
        "workspace_id": "T0SYNTH01", "channel_id": "D0DMCONV01",
        "message_ts": "1735689600.000100", "event_id": "Ev0SYNTH0001",
        "conversation_type": "dm", "thread_ts": null,
        "sender_id": "U0MEMBER01", "sender_type": "human",
        "sender_is_external": false, "sender_is_guest": false,
        "sent_at": "2025-01-01T00:00:00.000Z",
        "text": "what did we decide about the retry policy", "addressed_to_gist": true
      }
    },
    {
      "name": "channel_mention_addressed",
      "expect_class": "addressed",
      "event": {
        "contract_version": "1.0.0", "class": "addressed",
        "workspace_id": "T0SYNTH01", "channel_id": "C0APPROVED1",
        "message_ts": "1735689700.000100", "event_id": "Ev0SYNTH0002",
        "conversation_type": "channel", "thread_ts": "1735689650.000100",
        "sender_id": "U0MEMBER01", "sender_type": "human",
        "sender_is_external": false, "sender_is_guest": false,
        "sent_at": "2025-01-01T00:01:40.000Z",
        "text": "remind us what the rollout window was", "addressed_to_gist": true
      }
    },
    {
      "name": "ambient_channel_message",
      "note": "UJ4/INV-6 — stored silently, zero model calls, no reply.",
      "expect_class": "ambient",
      "event": {
        "contract_version": "1.0.0", "class": "ambient",
        "workspace_id": "T0SYNTH01", "channel_id": "C0APPROVED1",
        "message_ts": "1735689800.000100", "event_id": "Ev0SYNTH0003",
        "conversation_type": "channel", "thread_ts": null,
        "sender_id": "U0MEMBER02", "sender_type": "human",
        "sender_is_external": false, "sender_is_guest": false,
        "sent_at": "2025-01-01T00:03:20.000Z",
        "text": "rollout window is Tuesday 09:00-11:00 UTC", "addressed_to_gist": false
      }
    }
  ],
  "thread_root_encodings": {
    "note": "identity.md §3 — both encodings MUST yield one thread_id. Failing this splits a conversation in two.",
    "encoding_a_absent": { "message_ts": "1735689650.000100", "thread_ts": null },
    "encoding_b_self_referential": { "message_ts": "1735689650.000100", "thread_ts": "1735689650.000100" },
    "expect_same_thread_root_ts": "1735689650.000100"
  },
  "timestamp_precision_pair": {
    "note": "slack-event.md §2 — these are DISTINCT messages. A float round-trip collapses them; message_ts must stay a verbatim string.",
    "a": "1735689600.000200",
    "b": "1735689600.0002",
    "expect_distinct_message_keys": true
  },
  "mutations": [
    {
      "name": "edit_existing",
      "expect": { "text_updated": true, "re_embedded": true, "stale_embedding_removed": true },
      "mutation": { "kind": "edit", "target_ts": "1735689800.000100", "edited_at": "2025-01-01T00:10:00.000Z", "new_text": "rollout window moved to Wednesday 09:00-11:00 UTC" }
    },
    {
      "name": "delete_existing",
      "expect": { "record_deleted": true, "embedding_deleted": true, "tombstone_left": true, "tombstone_has_text": false },
      "mutation": { "kind": "delete", "target_ts": "1735689800.000100", "edited_at": "2025-01-01T00:12:00.000Z" }
    },
    {
      "name": "mutation_for_never_stored_message",
      "expect": { "result": "no_op_success", "is_error": false },
      "mutation": { "kind": "edit", "target_ts": "1735600000.999999", "edited_at": "2025-01-01T00:13:00.000Z", "new_text": "irrelevant" }
    },
    {
      "name": "replayed_mutation",
      "expect": { "result": "no_op_success", "idempotent": true },
      "mutation": { "kind": "delete", "target_ts": "1735689800.000100", "edited_at": "2025-01-01T00:12:00.000Z" }
    },
    {
      "name": "mutation_unapproved_channel",
      "note": "D005 — denied BEFORE storage lookup so it cannot probe stored state.",
      "channel_id": "C0UNAPPROV9",
      "expect": { "denied_at": "authorization", "storage_touched": false, "deny_reason": "unapproved_channel" },
      "mutation": { "kind": "delete", "target_ts": "1735689900.000100", "edited_at": "2025-01-01T00:14:00.000Z" }
    },
    {
      "name": "original_arrives_after_delete",
      "expect": { "suppressed_by_tombstone": true, "record_recreated": false },
      "late_delivery_of_ts": "1735689800.000100"
    }
  ],
  "skips": [
    { "expect_skip": "bot_message", "sender_id": "B0GISTBOT1", "sender_type": "bot" },
    { "expect_skip": "own_message", "sender_id": "B0GISTBOT1", "is_self": true },
    { "expect_skip": "app_message", "sender_type": "app" },
    { "expect_skip": "system_subtype", "subtype": "channel_join" },
    { "expect_skip": "empty_text", "text": "" },
    { "expect_skip": "malformed_event", "raw": { "unknown_shape": true } },
    { "expect_skip": "duplicate_delivery", "event_id": "Ev0SYNTH0003", "note": "same envelope redelivered; AC-06" },
    { "expect_skip": "unapproved_channel", "channel_id": "C0UNAPPROV9", "produced_by": "authorization" },
    { "expect_skip": "unapproved_workspace", "workspace_id": "T0SYNTH99", "produced_by": "authorization" },
    { "expect_skip": "external_user", "sender_id": "U0EXTERN01", "produced_by": "authorization" },
    { "expect_skip": "guest_user", "sender_id": "U0GUEST001", "produced_by": "authorization" }
  ]
}
